{
  "tasks": {
    "check": "deno check extensions/models/*.ts",
    "lint": "deno lint extensions/",
    "fmt": "deno fmt extensions/",
    "test": "deno test --allow-read extensions/models/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "lint": {
    "include": ["extensions/"],
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  },
  "compilerOptions": {
    "strict": true
  }
}
